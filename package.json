{
  "name": "oscilla",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:preload && vite",
    "build:preload": "bun build src/preload/index.ts --outfile src-tauri/inject/preload.js --target browser --minify --format iife",
    "build": "tsc && vite build && bun run build:remote && bun run build:preload",
    "build:remote": "vite build -c vite.remote.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
