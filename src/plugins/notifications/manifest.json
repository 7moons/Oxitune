{
  "id": "app.ytmd.notifications",
  "name": "Track Change Notifications",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Displays native desktop notifications when songs change",
  "author": "Oscilla",
  "matches": [
    "https://music.youtube.com/*"
  ],
  "runAt": "document-idle",
  "permissions": [
    "player:read",
    "internal:config",
    "internal:notify"
  ],
  "entry": "index.js"
}
