{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Music",
  "version": "1.0.0",
  "identifier": "com.ytmd.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YouTube Music",
        "url": "https://music.youtube.com",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      },
      {
        "label": "miniplayer",
        "title": "YTMD Mini Player",
        "url": "miniplayer.html",
        "width": 320,
        "height": 400,
        "minWidth": 260,
        "minHeight": 320,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "visible": false,
        "transparent": false
      },
      {
        "label": "settings",
        "title": "YTMD Preferences",
        "url": "settings.html",
        "width": 760,
        "height": 620,
        "minWidth": 540,
        "minHeight": 440,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "YouTube Music Desktop"
    }
  },
  "plugins": {
    "global-shortcut": {},
    "notification": {},
    "store": {}
  }
}
