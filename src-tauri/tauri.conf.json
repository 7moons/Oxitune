{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTMD",
  "version": "0.2.0",
  "identifier": "com.ytmd.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:24681",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "miniplayer",
        "title": "YTMD Mini Player",
        "url": "miniplayer.html",
        "width": 320,
        "height": 420,
        "minWidth": 260,
        "minHeight": 320,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "visible": false,
        "transparent": false
      },
      {
        "label": "settings",
        "title": "YTMD Preferences",
        "url": "settings.html",
        "width": 780,
        "height": 640,
        "minWidth": 540,
        "minHeight": 440,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": false,
        "visible": false
      },
      {
        "label": "local",
        "title": "YTMD Local Music Library",
        "url": "local.html",
        "width": 900,
        "height": 650,
        "minWidth": 600,
        "minHeight": 450,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": false,
        "visible": false
      },
      {
        "label": "sync",
        "title": "YTMD Listen Together (Room Sync)",
        "url": "sync.html",
        "width": 640,
        "height": 520,
        "minWidth": 480,
        "minHeight": 380,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3MjFFMUJGNzBDMzQ1OTEKUldTUlJjTnd2K0VocDJobjF2ZVNhTTVleCs3TEZDenc5NGhjM2V5VHhGdUh6VStCOWtTR0lacEcK",
      "endpoints": [
        "https://ytmd-updates.kayzed.workers.dev/latest.json"
      ]
    }
  }
}
