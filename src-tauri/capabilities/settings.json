{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window (local page).",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-close-window",
    "allow-get-current-track",
    "allow-get-config",
    "allow-save-config",
    "allow-set-shortcut",
    "allow-reset-shortcuts",
    "allow-open-logs-folder",
    "allow-export-settings",
    "allow-import-settings",
    "allow-get-remote-info",
    "allow-regenerate-remote-token",
    "allow-get-app-version",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-restart-app",
    "allow-plugins-list",
    "allow-plugins-set-enabled",
    "allow-plugins-uninstall",
    "allow-plugins-set-setting",
    "allow-plugins-add-registry",
    "allow-plugins-remove-registry",
    "allow-plugins-restore-official",
    "allow-plugins-pick-media-dir",
    "allow-plugins-open-media-dir",
    "allow-plugins-available",
    "allow-plugins-install",
    "allow-plugins-check-updates",
    "allow-plugins-add-dev",
    "allow-plugins-set-update-interval"
  ]
}
