{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for all windows including YouTube Music webview",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "global-shortcut:default",
    "notification:default",
    "shell:default"
  ],
  "remote": {
    "urls": ["https://music.youtube.com", "https://music.youtube.com/*"]
  }
}
