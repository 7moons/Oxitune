{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sync",
  "description": "Listen Together window (local page).",
  "windows": ["sync"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-close-window",
    "allow-get-current-track",
    "allow-create-sync-room",
    "allow-join-sync-room",
    "allow-leave-sync-room",
    "allow-get-sync-room-state",
    "allow-kick-sync-member",
    "allow-set-sync-member-role",
    "allow-set-sync-default-role",
    "allow-unban-sync-member",
    "allow-end-sync-room",
    "allow-transfer-sync-host",
    "allow-set-sync-require-approval",
    "allow-set-discord-invite",
    "allow-get-discord-invite",
    "allow-take-pending-join-code",
    "allow-decide-sync-join",
    "allow-vote-sync-skip",
    "allow-send-sync-reaction",
    "allow-sync-queue-remove",
    "allow-sync-queue-play",
    "allow-sync-queue-move",
    "allow-test-sync-connection"
  ]
}
