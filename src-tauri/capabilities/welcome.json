{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "welcome",
  "description": "First-launch welcome window (local page).",
  "windows": ["welcome"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-minimize-window",
    "allow-close-window",
    "allow-get-config",
    "allow-save-config",
    "allow-finish-onboarding"
  ]
}
